# Supabase (Google Auth built-in)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# App URL (for OAuth callback)
NEXT_PUBLIC_APP_URL=https://dialer.thejetzt.com

# Telnyx -- phone-bridge calling (TeXML)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx
TELNYX_TEXML_CONNECTION_ID=your_texml_application_connection_id
TELNYX_PUBLIC_KEY=your_telnyx_account_public_key

# Telnyx -- browser (WebRTC) calling, a Credential Connection separate from
# the TeXML one above
TELNYX_WEBRTC_USERNAME=your_webrtc_connection_username
TELNYX_WEBRTC_PASSWORD=your_webrtc_connection_password

# Shared mailbox (IMAP + SMTP) for the Mail feature
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=business@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_NAME=Your Company Name
