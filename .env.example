# Supabase (Google Auth built-in)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# App URL (for OAuth callback)
NEXT_PUBLIC_APP_URL=https://dialer.thejetzt.com

# Telnyx
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+1xxxxxxxxxx
TELNYX_TEXML_CONNECTION_ID=your_texml_application_connection_id
TELNYX_PUBLIC_KEY=your_telnyx_account_public_key
